+    // Handwriting fork: write directly into text fields (API 33+ stylus handwriting).
+    private val stylusHandwriting by lazy {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.TIRAMISU) null
+        else StylusHandwritingController(
+            service = this,
+            scope = lifecycleScope,
+            locale = { RichInputMethodManager.getInstance().currentSubtypeLocales.firstOrNull()?.toLanguageTag() ?: "en" },
+            createTransaction = { runCatching { imeManager.createInputTransaction() }.getOrNull() },
+        )
+    }
+
+    override fun onStartStylusHandwriting(): Boolean =
+        Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU && stylusHandwriting?.onStart() == true
+
+    override fun onFinishStylusHandwriting() {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) stylusHandwriting?.onFinish()
+    }
+
     private var destroying = false
     override fun onDestroy() {
         destroying = true
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) stylusHandwriting?.onDestroy()
         unregisterReceiver(unlockReceiver)
         stopJobs()
         viewModelStore.clear()
